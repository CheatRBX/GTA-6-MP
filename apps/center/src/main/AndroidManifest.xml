<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_corax"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <!-- Экран «Добро пожаловать». Это HOME с приоритетом 1: ниже мастера LineageOS,
             выше обычного лаунчера (0). Поэтому он открывается сразу после мастера Lineage,
             а когда пользователь закончит, отключает сам себя и уступает лаунчеру.
             Приоритет HOME учитывается только у системных приложений (priv-app). -->
        <activity
            android:name=".WelcomeActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/welcome_title"
            android:launchMode="singleTask">
            <intent-filter android:priority="1">
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Плитка на главном экране Настроек. Настройки показывают такие плитки только
             от системных приложений. -->
        <activity
            android:name=".CenterActivity"
            android:exported="true"
            android:icon="@drawable/ic_corax"
            android:label="@string/center_title">
            <intent-filter>
                <action android:name="com.android.settings.action.EXTRA_SETTINGS" />
            </intent-filter>
            <meta-data
                android:name="com.android.settings.category"
                android:value="com.android.settings.category.ia.homepage" />
            <meta-data
                android:name="com.android.settings.order"
                android:value="100" />
            <meta-data
                android:name="com.android.settings.summary"
                android:resource="@string/center_summary" />
            <meta-data
                android:name="com.android.settings.icon"
                android:resource="@drawable/ic_corax" />
        </activity>
        <!-- Иконка в списке приложений — только когда APK поставлен как обычное приложение
             (демо на любом телефоне). В GSI Corax OS приложение системное и прячет её само. -->
        <activity-alias
            android:name=".DemoLauncher"
            android:exported="true"
            android:icon="@drawable/ic_corax"
            android:label="@string/center_title"
            android:targetActivity=".CenterActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
    </application>
</manifest>
